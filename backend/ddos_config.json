{
  "enabled": true,
  "log_level": "info",
  "redis_url": "redis://localhost:6379/0",
  "use_redis": true,
  "fallback_to_memory": true,
  "rate_limits": {
    "anonymous_rps": 10,
    "anonymous_rpm": 200,
    "anonymous_rph": 5000,
    "authenticated_rps": 30,
    "authenticated_rpm": 600,
    "authenticated_rph": 15000,
    "api_key_rps": 50,

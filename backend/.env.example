# ==============================================================================
# MDEFENDER-PRO ARCHITECTURE GUIDELINES FOR ANTIGRAVITY AI & DEVELOPERS
# (CRITICAL: READ THIS BEFORE MODIFYING ANY WAF, LOGGING, OR DATABASE CODE)
# ==============================================================================
#
# 1. ZERO MONGODB ATTACK/VISITOR LOG STORAGE RULE:
#    - Individual attack and visitor logs are NEVER stored in MongoDB collections.
#      Collections like 'security_events', 'attacks', 'requests', 'live_site_events',
#      and 'waf_events' are DEPRECATED and DROPPED.
#    - All authentic traffic & attack logs live in the customer WordPress MySQL
#      database table: `wp_waf_attacks`.
#    - MongoDB stores ONLY: user accounts, website metadata, API keys, custom WAF rules,
#      malware scan reports, and live aggregate counters (total_requests, requests_today,
#      total_blocked, blocked_today).
#
# 2. LIVE BROADCAST STREAM ARCHITECTURE (USER DASHBOARD LOGS):
#    - The User Dashboard (/user/logs) queries connected WordPress sites on-demand
#      via HTTP GET proxy: `/?waf_cloud_sync=1&action=get_logs&api_key={key}&site_token={key}`
#    - If a site is disconnected or returns 0 logs, the dashboard shows 0 logs.
#    - NEVER fall back to old MongoDB persistent collections. Zero ghost logs!
#
# 3. STEALTH "WEBSITE DOWN" ERROR (HTTP 502 BAD GATEWAY):
#    - Whenever an IP is Blacklisted or a Country is Geo-Restricted, visiting the site
#      MUST ALWAYS show the authentic browser offline screen:
#      "This site can’t be reached / {domain} unexpectedly closed the connection. / ERR_CONNECTION_CLOSED"
#      with HTTP 502 Bad Gateway and Connection: close.
#    - It must NEVER show HTTP 403 Forbidden or any "MDefender Pro AI Access Denied" WAF page.
#
# 4. LOG PURGE & RETENTION PROTOCOL:
#    - Clicking "Clear Logs" sends `action=clear_logs` to connected WordPress sites,
#      which purges `wp_waf_attacks` in MySQL, resets website counters to 0, and drops
#      all backend in-memory cache dictionaries.
#
# 5. LITESPEED & REVERSE PROXY AUTHENTICATION SAFEGUARD:
#    - Always pass credentials in query parameters (`&api_key=...&site_token=...`)
#      AND in the JSON body, because LiteSpeed/Apache reverse proxies strip the
#      `Authorization: Bearer` header by default.
# ==============================================================================

PORT=8000
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=mdefender_pro
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
EMAIL_ALERTS=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://mdefender-pro.crafix.tech/auth/google/callback
FRONTEND_URL=https://mdefender-pro.crafix.tech
CORS_ORIGINS=https://mdefender-pro.crafix.tech,http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Paddle Billing
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_api_key
PADDLE_CLIENT_TOKEN=your_paddle_client_token
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret

# Edge Proxy & DNS
DNS_SERVER_ENABLED=false
DNS_SERVER_PORT=53
WAF_EDGE_IP=217.15.170.82
MDEFENDER_NAMESERVERS=ns1.mdefender-pro.crafix.tech,ns2.mdefender-pro.crafix.tech
